# ==============================================================
# VE-AI Environment Configuration
# ==============================================================
# Copy this file to ".env" and fill in your values to enable a
# real LLM. If these are left blank, the application automatically
# runs in "Demo Mode - Mock AI" using deterministic, predefined
# alternatives so the prototype is always runnable.
# ==============================================================

# Your API key for an OpenAI-compatible endpoint
OPENAI_API_KEY=

# Base URL for the OpenAI-compatible API.
# Examples:
#   OpenAI:            https://api.openai.com/v1
#   Azure OpenAI:      https://<resource>.openai.azure.com/openai/v1
#   Local/self-hosted:  http://localhost:11434/v1  (e.g. Ollama with OpenAI shim)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name to use for generation
OPENAI_MODEL=gpt-4o-mini
